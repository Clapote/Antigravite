{
  "name": "antigravite",
  "version": "1.1.2",
  "description": "Application personnelle de gestion des tâches",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "powershell -ExecutionPolicy Bypass -File tests/run_tests.ps1",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "fr.antigravite.app",
    "productName": "Antigravite",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "Clapote",
      "repo": "Antigravite-releases",
      "releaseType": "release",
      "private": false
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/**/*",
      "!assets/originals/**/*",
      "css/**/*",
      "js/**/*",
      "services/**/*",
      "data/**/*",
      "package.json",
      "!**/*.bak*",
      "!**/*.backup*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}.Setup.${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
